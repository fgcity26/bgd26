{
  "name": "bgd26",
  "version": "0.1.0",
  "private": true,
  "description": "bgd26.com — unified business operating system for Bangladesh",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file=.env.local --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "verify:auth": "tsx scripts/verify-auth.mts",
    "verify:catalog": "tsx scripts/verify-catalog.mts",
    "verify:crm": "tsx scripts/verify-crm.mts",
    "verify:inventory": "tsx scripts/verify-inventory.mts",
    "verify:purchasing": "tsx scripts/verify-purchasing.mts",
    "verify:orders": "tsx scripts/verify-orders.mts",
    "verify:accounting": "tsx scripts/verify-accounting.mts",
    "verify:loyalty": "tsx scripts/verify-loyalty.mts",
    "verify:storefront": "tsx scripts/verify-storefront.mts",
    "verify:shipping": "tsx scripts/verify-shipping.mts",
    "verify:reports": "tsx scripts/verify-reports.mts",
    "verify:purchasing-settlement": "tsx scripts/verify-purchasing-settlement.mts",
    "verify:production": "tsx scripts/verify-production.mts",
    "verify:dropship": "tsx scripts/verify-dropship.mts",
    "verify:account": "tsx scripts/verify-account.mts",
    "verify:ai": "tsx scripts/verify-ai.mts",
    "verify:invariants": "node scripts/verify-invariants.mjs",
    "format": "prettier --write .",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:local": "prisma dev --name bgd26dev",
    "db:local:detach": "prisma dev --detach --name bgd26dev",
    "db:local:setup": "node scripts/init-secrets.mjs && node scripts/local-db.mjs",
    "db:reset": "prisma migrate reset",
    "env:check": "node scripts/check-env.mjs",
    "env:setup": "node scripts/setup-env.mjs && node scripts/init-secrets.mjs",
    "secrets:init": "node scripts/init-secrets.mjs",
    "schema:check": "python3 scripts/check-schema.py"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "prettier": "^3.10.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true
  }
}

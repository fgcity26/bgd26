// =============================================================================
// bgd26.com — Unified Business Operating System for Bangladesh
// Prisma schema — Phase 1 (architecture gate)
//
// Provider  : PostgreSQL 15+ (Supabase)
// Money     : Decimal(14,2)      Unit cost : Decimal(14,4)
// Quantity  : Decimal(14,3)      IDs       : cuid()
// Tables    : 84 core business tables + 6 storefront-engagement tables = 90
//
// Conventions
//  - Every table is mapped to the exact snake_case name required by the spec.
//  - Financial and stock tables are append-only: no updatedAt, no hard deletes.
//  - Soft archival uses status = ARCHIVED (products/variants/users).
//  - Actor columns are nullable so deleting a staff login never destroys history.
//  - Business invariants that Prisma cannot express (balanced journals,
//    WALK_IN_CASH rules, bundle cycles, negative-stock policy) are enforced by
//    service-layer guards + PostgreSQL CHECK constraints added in the Phase 2
//    migration. See docs/ARCHITECTURE.md §12.
//
// Prisma 7: the connection URL lives in prisma.config.ts (CLI/migrations) and
// the runtime uses the node-postgres driver adapter (see src/lib/db.ts).
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


# =============================================================================
# bgd26.com — Environment Template
# Copy to .env.local and fill real values. NEVER commit .env.local or .env*.
#
#   cp .env.example .env.local
#
# Rule: secrets live only in .env.local (local) and Vercel/Supabase dashboards
# (production). No secret is ever hardcoded in source code.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APPLICATION
# -----------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="bgd26"
NEXT_PUBLIC_DEFAULT_LOCALE=bn
NEXT_PUBLIC_SUPPORTED_LOCALES=bn,en
TZ=Asia/Dhaka
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# 2. DATABASE (Supabase PostgreSQL)
# DATABASE_URL = transaction pooler (port 6543) used by the app at runtime.
# DIRECT_URL   = direct/session connection (port 5432) used by Prisma migrations.
# URL-encode special characters in the password.
# Prisma 7 reads these from prisma.config.ts, not from the schema file.
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
# Small pool: the Supabase pooler already multiplexes connections.
DATABASE_POOL_MAX=5

# -----------------------------------------------------------------------------
# 3. SUPABASE AUTH & REALTIME
# SERVICE_ROLE_KEY bypasses RLS. Server-only. Never prefix with NEXT_PUBLIC_.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
SUPABASE_JWT_SECRET=<supabase-jwt-secret>

# -----------------------------------------------------------------------------
# 4. APPLICATION AUTH & CRYPTO
# Generate: openssl rand -base64 32
# MANAGER_PIN_PEPPER protects manager PIN hashes (4-6 digit PINs need a pepper).
# FIELD_ENCRYPTION_KEY encrypts provider credentials at rest if ever stored.
# -----------------------------------------------------------------------------
# local = users.passwordHash (works offline); supabase = Supabase Auth.
AUTH_PROVIDER=local
AUTH_SECRET=<random-32-byte-base64>
MANAGER_PIN_PEPPER=<random-32-byte-base64>
FIELD_ENCRYPTION_KEY=<random-32-byte-base64>
SESSION_COOKIE_NAME=bgd26_session
SESSION_TTL_SECONDS=604800
CRON_SECRET=<random-32-byte-base64>
RATE_LIMIT_SALT=<random-16-byte-base64>

# -----------------------------------------------------------------------------
# 5. OBJECT STORAGE (S3-compatible: AWS S3 / Cloudflare R2 / Backblaze B2)
# GALLERY bucket is public-read and stores ORIGINAL bytes (zero transform).
# CUSTOMIZATION bucket is PRIVATE. Only short-lived signed URLs are issued.
# -----------------------------------------------------------------------------
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=<s3-access-key>
S3_SECRET_ACCESS_KEY=<s3-secret-key>
S3_BUCKET_GALLERY=bgd26-media-public
S3_BUCKET_CUSTOMIZATION=bgd26-customization-private
S3_BUCKET_DOCUMENTS=bgd26-documents-private
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=https://media.bgd26.com
MEDIA_SIGNED_URL_TTL_SECONDS=300
MEDIA_MAX_UPLOAD_BYTES=20971520
# Never resize/recompress/convert. These are validation allow-lists only.
MEDIA_ALLOWED_MIME_TYPES=image/webp,image/avif,image/jpeg,image/png,application/pdf

# Storage adapter. local = files on this machine (development/self-hosted);
# supabase = Supabase Storage (production default when NODE_ENV=production).
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.data/media
STORAGE_LOCAL_BUCKET=local
SUPABASE_STORAGE_BUCKET=bgd26-media

# -----------------------------------------------------------------------------
# 6. PAYMENTS — SSLCommerz
# -----------------------------------------------------------------------------
SSLCOMMERZ_STORE_ID=<store-id>
SSLCOMMERZ_STORE_PASSWORD=<store-password>
SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com
SSLCOMMERZ_SUCCESS_URL=http://localhost:3000/api/payments/sslcommerz/success
SSLCOMMERZ_FAIL_URL=http://localhost:3000/api/payments/sslcommerz/fail
SSLCOMMERZ_CANCEL_URL=http://localhost:3000/api/payments/sslcommerz/cancel
SSLCOMMERZ_IPN_URL=http://localhost:3000/api/payments/sslcommerz/ipn

# -----------------------------------------------------------------------------
# 7. PAYMENTS — bKash (Tokenized Checkout)
# -----------------------------------------------------------------------------
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=<bkash-app-key>
BKASH_APP_SECRET=<bkash-app-secret>
BKASH_USERNAME=<bkash-username>
BKASH_PASSWORD=<bkash-password>

# -----------------------------------------------------------------------------
# 8. PAYMENTS — Nagad
# -----------------------------------------------------------------------------
NAGAD_BASE_URL=https://sandbox-ssl.mynagad.com
NAGAD_MERCHANT_ID=<nagad-merchant-id>
NAGAD_MERCHANT_PRIVATE_KEY=<nagad-private-key>
NAGAD_PG_PUBLIC_KEY=<nagad-public-key>

# -----------------------------------------------------------------------------
# 9. COURIERS
# -----------------------------------------------------------------------------
PATHAO_BASE_URL=https://api-hermes.pathao.com
PATHAO_CLIENT_ID=<pathao-client-id>
PATHAO_CLIENT_SECRET=<pathao-client-secret>
PATHAO_STORE_ID=<pathao-store-id>

STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_API_KEY=<steadfast-api-key>
STEADFAST_SECRET_KEY=<steadfast-secret-key>

REDX_BASE_URL=https://openapi.redx.com.bd/v1.0.0-beta
REDX_API_KEY=<redx-api-key>

# Dropship suppliers that provide their own tracking push a shared secret here.
DROPSHIP_WEBHOOK_SECRET=<random-32-byte-base64>

# -----------------------------------------------------------------------------
# 10. WHATSAPP BUSINESS CLOUD API (official Meta Graph API)
# APP_SECRET verifies X-Hub-Signature-256 HMAC on every webhook.
# -----------------------------------------------------------------------------
WHATSAPP_GRAPH_API_VERSION=v21.0
# E.164 display number, e.g. +8801XXXXXXXXX. Informational until 4c is built.
WHATSAPP_BUSINESS_NUMBER=<business-phone-number>
WHATSAPP_PHONE_NUMBER_ID=<phone-number-id>
WHATSAPP_BUSINESS_ACCOUNT_ID=<waba-id>
WHATSAPP_ACCESS_TOKEN=<system-user-access-token>
WHATSAPP_APP_SECRET=<meta-app-secret>
WHATSAPP_VERIFY_TOKEN=<random-verify-token>

# -----------------------------------------------------------------------------
# 11. AI ASSISTANT (server-side only; read/draft tools, never writes money/stock)
# -----------------------------------------------------------------------------
# local = deterministic rules engine, no key needed and works offline.
# openai = Chat Completions tool calling; requires AI_API_KEY below.
# If openai is requested without a key, the app falls back to local and says so.
AI_PROVIDER=local
AI_MODEL=gpt-4.1-mini
AI_API_KEY=
# Optional compatible endpoint. Empty uses https://api.openai.com/v1.
AI_BASE_URL=
AI_MAX_OUTPUT_TOKENS=1200
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_TOOL_ROUNDS=4
AI_MAX_TOOL_CALLS_PER_TURN=5
# Durable hourly limits and an optional monthly token budget (0 = unlimited).
AI_REQUESTS_PER_HOUR=60
AI_MAX_DRAFTS_PER_HOUR=10
AI_MONTHLY_TOKEN_BUDGET=0
AI_ENABLED=true
AI_DRAFT_ORDERS_ENABLED=true

# -----------------------------------------------------------------------------
# 12. NOTIFICATIONS (optional providers)
# -----------------------------------------------------------------------------
RESEND_API_KEY=<resend-api-key>
EMAIL_FROM="bgd26 <no-reply@bgd26.com>"
SMS_PROVIDER=bulksmsbd
SMS_API_KEY=<sms-api-key>
SMS_SENDER_ID=bgd26

# -----------------------------------------------------------------------------
# 13. OBSERVABILITY & JOBS
# -----------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_ANALYTICS_ID=
# Vercel Cron calls these routes with: Authorization: Bearer $CRON_SECRET
CRON_LOYALTY_EXPIRY=0 3 * * *
CRON_RESERVATION_EXPIRY=*/15 * * * *
CRON_SYNC_ALERTS=*/5 * * * *

# -----------------------------------------------------------------------------
# 14. FEATURE FLAGS (first release = all core modules ON)
# -----------------------------------------------------------------------------
FEATURE_POS_OFFLINE=true
FEATURE_DROPSHIPPING=true
FEATURE_WHATSAPP=true
FEATURE_AI_ASSISTANT=true
FEATURE_BUNDLES=true
FEATURE_LOYALTY=true
FEATURE_MULTI_WAREHOUSE=true
FEATURE_PRODUCT_REVIEWS=true
FEATURE_WISHLIST=true
FEATURE_NEWSLETTER=true
FEATURE_CONTENT_PAGES=true

# -----------------------------------------------------------------------------
# 15. STOREFRONT ENGAGEMENT
# -----------------------------------------------------------------------------
# Manual moderation is the safe default: new reviews stay PENDING until staff
# approve them. Set false only if you want verified purchases to auto-publish.
REVIEWS_REQUIRE_MODERATION=true
REVIEWS_MAX_IMAGES=5
# Double opt-in: PENDING -> email confirmation -> SUBSCRIBED.
NEWSLETTER_DOUBLE_OPT_IN=true
NEWSLETTER_FROM_NAME=BGD26
NEWSLETTER_FROM_EMAIL=news@bgd26.com

# -----------------------------------------------------------------------------
# 16. SEEDING (only used by `npm run db:seed`)
# The seed refuses to run with NODE_ENV=production unless SEED_ALLOW_PROD=true.
# Change the owner password and manager PIN immediately after the first login.
# -----------------------------------------------------------------------------
SEED_OWNER_EMAIL=owner@bgd26.com
SEED_OWNER_PASSWORD=
SEED_OWNER_PIN=
SEED_ALLOW_PROD=false
